{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "reference/app/**",
              "ui_kits/app/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Inter, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='KbButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<KbButton> doesn't accept that prop. Declared props: variant, size, children, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KbButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|link)$/]",
        "message": "<KbButton> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KbButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<KbButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KbCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:boss|hover|title|meta|children|style|key|ref|className|style|children)$/]",
        "message": "<KbCard> doesn't accept that prop. Declared props: boss, hover, title, meta, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KbChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|color|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<KbChip> doesn't accept that prop. Declared props: on, color, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KbEmblem'] > JSXAttribute > JSXIdentifier[name!=/^(?:material|level|size|locked|key|ref|className|style|children)$/]",
        "message": "<KbEmblem> doesn't accept that prop. Declared props: material, level, size, locked."
      },
      {
        "selector": "JSXOpeningElement[name.name='KbEmblem'] > JSXAttribute[name.name='material'] > Literal[value!=/^(?:bronce|plata|oro|platino|obsidiana|diamante|esmeralda|rubi|damasco)$/]",
        "message": "<KbEmblem> material must be one of 'bronce' | 'plata' | 'oro' | 'platino' | 'obsidiana' | 'diamante' | 'esmeralda' | 'rubi' | 'damasco'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KbStatPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|value|style|key|ref|className|style|children)$/]",
        "message": "<KbStatPill> doesn't accept that prop. Declared props: kind, value, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KbStatPill'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:coin|gem|streak|hp|xp)$/]",
        "message": "<KbStatPill> kind must be one of 'coin' | 'gem' | 'streak' | 'hp' | 'xp'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
